    font-size: 13px;
    line-height: 1.6;
    color: #94a3b8;
    margin: 0;
  }
  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-bottom: 28px;
  }
  .faq-item {
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 14px 16px;
  }
  .faq-item summary {
    cursor: pointer;
    font-size: 14px;
    color: var(--text);
  }
  .faq-item p {
    font-size: 13px;
    line-height: 1.7;
    color: #94a3b8;
    margin: 10px 0 0;
  }
  .matrix-cross-hub {
    padding-top: 20px;
    border-top: 1px solid var(--line);
  }
  .hub-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
  }
  .hub-item {
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 12px 14px;
    text-decoration: none;
    transition: all 0.2s;
  }
  .hub-item:hover {
    border-color: #0284c7;
    background: rgba(2, 132, 199, 0.04);
  }
  .hub-item strong {
    display: block;
    font-size: 13px;
