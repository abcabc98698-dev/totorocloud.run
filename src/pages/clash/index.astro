    color: #fff;
    border-radius: 4px;
    text-decoration: none;
  }
  .btn-mini:hover {
    background: #0369a1;
  }
  .feature-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
    margin: 16px 0 24px;
  }
  .feature-card {
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 16px;
  }
  .feature-card h4 {
    font-size: 14px;
    font-weight: 700;
    color: var(--text);
    margin: 0 0 8px;
  }
