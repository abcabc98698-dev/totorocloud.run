    color: #0284c7;
    font-size: 14px;
    font-weight: 700;
  }
  .geo-answer-box p {
    font-size: 14px;
    line-height: 1.7;
    color: var(--text);
    margin: 0;
  }
  .section-title {
    font-size: 17px;
    font-weight: 700;
    color: var(--text);
    margin: 24px 0 14px;
  }
  .section-desc {
    font-size: 13px;
    line-height: 1.7;
    color: #94a3b8;
    margin-bottom: 16px;
  }
  .table-responsive {
    overflow-x: auto;
    margin: 16px 0 24px;
    border-radius: 8px;
    border: 1px solid var(--line);
  }
  .data-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13px;
    text-align: left;
    white-space: nowrap;
  }
  .data-table th, .data-table td {
    padding: 12px 14px;
    border-bottom: 1px solid var(--line);
  }
  .data-table th {
    background: var(--bg);
    font-weight: 700;
    color: var(--text);
  }
  .data-table tr:hover {
    background: rgba(2, 132, 199, 0.02);
  }
  .link-ext {
    color: #0284c7;
