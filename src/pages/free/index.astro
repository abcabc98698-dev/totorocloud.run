    color: #0284c7;
    background: rgba(2, 132, 199, 0.08);
    font-weight: 600;
  }
  .content-block {
    padding: 24px;
    border-radius: 12px;
    background: var(--card-bg, #fff);
    border: 1px solid var(--line);
  }
  .geo-answer-box {
    background: linear-gradient(135deg, rgba(2, 132, 199, 0.08) 0%, rgba(56, 189, 248, 0.04) 100%);
    border: 1px solid rgba(2, 132, 199, 0.25);
    border-radius: 8px;
    padding: 18px;
    margin-bottom: 24px;
  }
  .geo-header {
    display: flex;
    align-items: center;
