<style>
  .breadcrumb-nav {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: #94a3b8;
    margin-bottom: 20px;
    flex-wrap: wrap;
  }
  .breadcrumb-nav a {
    color: #94a3b8;
    text-decoration: none;
    transition: color 0.2s;
  }
  .breadcrumb-nav a:hover {
    color: #0284c7;
  }
  .breadcrumb-nav .sep {
    color: #cbd5e1;
  }
  .breadcrumb-nav .current {
    color: var(--text);
    font-weight: 500;
  }
  .column-hero {
    margin-bottom: 24px;
    padding: 28px 24px;
    background: linear-gradient(135deg, rgba(2, 132, 199, 0.05) 0%, rgba(56, 189, 248, 0.02) 100%);
    border: 1px solid rgba(2, 132, 199, 0.15);
    border-radius: 12px;
  }
  .hero-badge-wrap {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 12px;
    flex-wrap: wrap;
  }
  .hero-badge {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    padding: 3px 10px;
    border-radius: 4px;
    background: #0284c7;
    color: #fff;
  }
  .update-pill {
    font-size: 12px;
    color: #0284c7;
    font-weight: 600;
    background: rgba(2, 132, 199, 0.1);
    padding: 3px 10px;
    border-radius: 12px;
  }
  .hero-title {
    font-size: 24px;
    font-weight: 800;
    line-height: 1.35;
    color: var(--text);
    margin: 0 0 12px;
  }
  .hero-desc {
    font-size: 14px;
    line-height: 1.7;
    color: #94a3b8;
    margin: 0 0 20px;
  }
  .topic-nav-pills {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
    padding-top: 16px;
    border-top: 1px dashed var(--line);
  }
  .topic-nav-label {
    font-size: 12px;
    font-weight: 700;
    color: var(--text);
  }
  .pills-wrap {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }
  .pill-item {
    font-size: 12px;
    padding: 4px 10px;
    border-radius: 6px;
    background: var(--bg);
    border: 1px solid var(--line);
    color: var(--text);
    text-decoration: none;
    transition: all 0.2s;
  }
