        },
        {
          "@type": "Question",
          "name": "对于预算极度敏感的学生群体，最理性的过渡方案是什么？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "日常使用 ¥5.6/月 至 ¥15/月的平价专线机场作为主力保障（仅需一杯豆浆钱），同时配置 GitHub 开源项目或 Cloudflare Workers 作为断网应急 Fallback，彻底摆脱四处寻找失效节点的痛苦。"
          }
        }
      ]
    }
  ]
};
---

<BlogLayout
  title={title}
  description={description}
  heroTitle="免费资源专栏"
  pageType="CollectionPage"
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <!-- Breadcrumbs -->
  <nav class="breadcrumb-nav" aria-label="面包屑导航">
    <a href="/">首页</a>
    <span class="sep">/</span>
    <span class="current">免费资源专栏</span>
  </nav>

  <!-- Hero Header Card -->
  <header class="column-hero card">
    <div class="hero-badge-wrap">
      <span class="hero-badge">TOPIC CLUSTER · 权威专题专栏</span>
      <span class="update-pill">2026 持续动态更新 · 龙猫云实验室</span>
    </div>
    <h1 class="hero-title">免费开源资源、正版工具与安全避坑专栏</h1>
