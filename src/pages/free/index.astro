    border-radius: 4px;
    text-decoration: none;
  }
  .btn-mini:hover {
    background: #0369a1;
  }
  .feature-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
    margin: 16px 0 24px;
  }
  .feature-card {
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 16px;
  }
  .feature-card h4 {
    font-size: 14px;
    font-weight: 700;
    color: var(--text);
    margin: 0 0 8px;
  }
  .feature-card p {
    font-size: 13px;
    line-height: 1.6;
    color: #94a3b8;
    margin: 0;
  }
  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-bottom: 28px;
  }
  .faq-item {
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 14px 16px;
  }
  .faq-item summary {
    cursor: pointer;
    font-size: 14px;
    color: var(--text);
  }
  .faq-item p {
    font-size: 13px;
    line-height: 1.7;
    color: #94a3b8;
    margin: 10px 0 0;
  }
  .matrix-cross-hub {
    padding-top: 20px;
