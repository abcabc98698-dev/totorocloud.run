---
import { getLanguage, languagePaths, useTranslations } from "../../i18n";
import BlogLayout from "../../layouts/BlogLayout.astro";
import { getPersonalInfo } from "../../config";
import { getAvatar } from "../../lib/avatar";

export const getStaticPaths = languagePaths;
const lang = getLanguage(Astro.params.lang);
const t = useTranslations(lang);
const personalInfo = getPersonalInfo(lang);

// 页面级 SEO 元数据配置
const pageTitle =
  lang === "zh"
    ? "关于龙猫云 (TotoroCloud) · 独立网络评测实验室方法论、客观性准则与透明度白皮书"
    : `${t("about.heroTitle")} · TotoroCloud`;

const pageDescription =
  lang === "zh"
    ? "深入了解龙猫云 (TotoroCloud) 评测实验室：由资深网络架构师与分布式系统工程师建立的独立客观网络可观测平台。详细公开三大骨干网晚高峰物理测速方法论、42家品牌评级模型（Totoro Score）、商业利益冲突防火墙与跨境外贸防关联安全指南。"
    : t("meta.aboutDescription");

// Schema.org 结构化数据 (AboutPage + Organization + FAQPage + BreadcrumbList)
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "AboutPage",
      "@id": `https://totorocloud.run/${lang === "zh" ? "" : lang + "/"}about/#about`,
      "url": `https://totorocloud.run/${lang === "zh" ? "" : lang + "/"}about/`,
      "name": pageTitle,
      "description": pageDescription,
      "publisher": {
        "@type": "Organization",
        "name": "龙猫云评测实验室 (TotoroCloud Lab)",
        "url": "https://totorocloud.run/",
        "logo": "https://totorocloud.run/favicon-48.png",
        "description": "专注于全球跨境网络链路可观测性、晚高峰真实物理抓包与机场横向评测的独立技术实验室。"
      },
      "datePublished": "2026-01-10T08:00:00+08:00",
      "dateModified": "2026-10-29T11:40:00+08:00"
    },
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "首页",
          "item": "https://totorocloud.run/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "关于龙猫云",
          "item": "https://totorocloud.run/about/"
        }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "龙猫云评测实验室的物理测速探针部署在哪些数据中心？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "龙猫云评测实验室在国内三大核心互联网骨干网节点部署了独享物理测试服务器：分别位于中国电信上海骨干机房（华东节点）、中国联通北京骨干机房（华北节点）以及中国移动广州骨干机房（华南节点）。所有探针均配备千兆独享物理光纤上联与 BGP 多线接入，测试环境彻底排除了本地家用 Wi-Fi 信号干扰、路由器 CPU 瓶颈与城域网接入拥塞。"
          }
        },
        {
          "@type": "Question",
          "name": "龙猫云与市面上常见的测速博主、Telegram 推广频道有何本质区别？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "普通营销博主普遍存在四大硬伤：1. 仅在白天低峰期跑一次测速图充当全天表现；2. 使用多线程测速刷虚高带宽峰值，掩盖恶性丢包；3. 接受机场商家的付费充值买榜与定向洗地；4. 忽视节点倍率刺客与落地 IP 欺诈分。龙猫云坚持：全天候 24 小时无人值守自动化探针抓包、专注于晚高峰（20:00–23:00）单线程丢包率与物理抖动、拒绝任何商家的充值置顶、全量审计节点倍率与原生住宅属性。"
          }
        },
        {
          "@type": "Question",
          "name": "龙猫云评测实验室的测试数据如何保证不受本地宽带波动的干扰？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "我们坚决不使用普通民用家庭宽带作为测试基准源。实验室探针均部署在具备三网直连资质的企业级 IDC Tier-3 机房内，探针系统本身配备与电信 163、联通 169、移动 CMI 的直接 BGP 对等互联（Peering）。在每次对机场节点发起测试前，探针会首先对国内权威公共基准源（如电信骨干 DNS 114.114.114.114 与阿里公共 DNS）进行基准 Ping 测试，只有当探针本地基准延迟标准差小于 0.5ms 时，抓取的数据才会被记入有效审计数据库。"
          }
        },
        {
          "@type": "Question",
          "name": "为什么有的机场在测速软件中能跑满 500Mbps，但你们却打出低分或列为预警？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "测速软件拉取大文件采用的是 8 到 16 线程并发下载，多线程拼命重传可以在账面上刷出漂亮的峰值数字；但在日常使用中（网页首屏渲染、API 通信、SSH 终端、流媒体握手），全部属于单线程短连接。如果该机场晚高峰物理丢包率高达 15%~30%，或者节点真实倍率高达 5.0x、落地 IP 属于高危机房黑名单段，即使测速数字再高，实际使用体验也极度恶劣。我们以单线程响应、抖动、真实可用性为核心权重，坚决挤出营销泡沫。"
          }
        },
        {
          "@type": "Question",
          "name": "龙猫云页面上的 AFF 推广佣金链接是否会影响评测排名与中立性？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "绝不影响。龙猫云评测实验室设立了严格的商业与学术防火墙：AFF 推广链接仅作为支撑昂贵物理探针机房租金与服务器折旧的微薄补充途径，且全网公开透明披露（统一标记 rel='nofollow sponsored noopener'）。实验室的所有排名与评分均由后台自动化测试数据库按固定权重算法自动生成，任何商家无法通过赞助或提高佣金比例改变其排名、延迟数据或风险警示标签。"
          }
        },
        {
          "@type": "Question",
          "name": "如果某家受推荐的机场发生严重掉线或跑路，龙猫云如何处理？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "实验室后台设置了 7x24 小时节点熔断监控警报：一旦某家品牌的节点连续 6 小时离线率超过 50%，或者官方交流群出现禁言、大量工单积压未处理的异常征兆，系统会自动触发风险警示，并在品牌库对应卡片上打上红色『服务异常预警』标签，同时下调或下架其推荐资格，第一时间在全站公告提醒读者停止续费与避免长期预付。"
          }
        },
        {
          "@type": "Question",
          "name": "龙猫云是否销售、转售或代购任何机场订阅套餐或梯子服务？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "坚决不销售、不运营、不代理。龙猫云评测实验室是纯粹的第三方网络性能测量、链路可观测性与分布式系统架构研究平台，既不搭建、也不销售任何代理翻墙服务。读者在第三方商家官网的一切购买与交互均属于读者与该商业实体之间的直接民事行为，请广大读者严格遵守当地法律法规。"
          }
        },
        {
          "@type": "Question",
          "name": "读者如何向龙猫云评测实验室反馈黑心机场的欺诈行为或数据偏差？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "读者可通过 GitHub 官方仓库 Issue 或实验室专用反馈邮箱向我们提交真实证据（包括但不限于账号充值记录、工单截图、未经通知的倍率暴增截图、晚高峰 MTR 路由追踪日志）。一旦经工程师团队复现与核实，我们将对涉事商家进行全站风险公示并在黑名单栏目中公开通报。"
          }
        },
        {
          "@type": "Question",
          "name": "什么是真正的 IPLC 与 IEPL 专线，如何识破假专线？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "真实的 IPLC（国际私有租用线路）与 IEPL（国际以太网专线）属于物理层与二层内网光纤穿透，端到端不过公网国际出口 GFW，晚高峰物理丢包率始终 < 0.5%，延迟标准差 < 1.5ms。若通过 MTR 探测发现路由跃点超过 12 跳，或者晚高峰延迟相比白天激增 30ms 以上并伴随大面积丢包，即可 100% 断定为拿普通公网 VPS 端口转发伪装的假专线。"
          }
        },
        {
          "@type": "Question",
          "name": "为什么龙猫云反复倡导“按月付费，拒绝超长年付”？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "机场行业具备极高的供应链波动性（上游专线物理断约、入口机房合规审计）与道德风险。绝大多数跑路机场均是在大量售出超低价“两年付/三年付”套餐、归集完资金池后突然失联。坚持按月付费不仅将最大的财务风险控制在一个月之内，还能让您随时根据商家的晚高峰服务质量自由投票切换，牢牢掌握消费主动权。"
          }
        },
        {
          "@type": "Question",
          "name": "用户在日常使用中如何自行测试与鉴别所用节点是否为真实双 ISP 原生住宅 IP？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "鉴别真实住宅 IP 可遵循以下三步简易自测流程：首先在代理连通后访问 ipinfo.io 查看 org 字段与 company.type，若显示为 isp 则代表运营商宽带，若显示为 hosting 则为机房段；其次访问 scamalytics.com 与 ipqualityscore.com 查询 Fraud Score 欺诈评分，通常分值低于 20 分才属于低风险原生段；最后在浏览器控制台检查 WebRTC 是否存在泄露真实内网或公网 IP 的行为。"
          }
        },
        {
          "@type": "Question",
          "name": "龙猫云未来是否会开源测试探针代码与开放公共数据 API？",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "是的。龙猫云工程团队目前正在重构基于 eBPF 的高性能网络探针与 UDP 灌包丢包采集守护进程（Totoro Agent 2.0）。我们计划在完成代码安全性与去敏感化脱敏审计后，将核心测速框架与时延采集管道在 GitHub 仓库进行开源，并面向全球技术极客与科研机构开放只读的 OpenAPI 数据接口。"
          }
        }
      ]
    }
  ]
};
---

<BlogLayout
  title={pageTitle}
  description={pageDescription}
  heroTitle={lang === "zh" ? "关于龙猫云评测实验室" : t("about.heroTitle")}
  pageType="ProfilePage"
>
  <script
    type="application/ld+json"
    set:html={JSON.stringify(structuredData)}
  />

  <!-- 顶部关于主名片 -->
  <article class="card page-card about-hero-card">
    <div class="about-intro">
      <img
        {...await getAvatar(88)}
        width="88"
        height="88"
        alt={personalInfo.name}
        class="avatar-circle"
      />
      <div class="intro-titles">
        <div class="badge-row">
          <span class="eyebrow-badge">INDEPENDENT NETWORK OBSERVATORY</span>
          <span class="status-badge"><span class="dot-live"></span> 独立中立运行中</span>
          <span class="date-badge">版本审计：2026年10月</span>
        </div>
        <h1>{lang === "zh" ? "龙猫云 (TotoroCloud) 评测实验室" : personalInfo.name}</h1>
        <p class="role-desc">
          {lang === "zh"
            ? "分布式网络架构师 · 全球链路可观测性工程师 · 独立中立评测团队"
            : personalInfo.role}
        </p>
      </div>
    </div>

    <!-- 实验室核心声明与引言 -->
    <div class="about-quote-box">
      <blockquote class="about-quote">
        “在充斥着营销话术、虚标倍率与充值排名的行业迷雾中，我们坚持以真实的骨干网物理抓包数据说话，用网络工程的严谨度衡量每一条跨境专线。”
      </blockquote>
    </div>

    <!-- 四大核心基石网格面板 -->
    <div class="principles-grid">
      <div class="principle-box">
        <div class="p-icon-wrap"><span class="icon-[lucide--shield-check] p-icon"></span></div>
        <div class="p-content">
          <h4>100% 真实物理测速</h4>
          <p>
            所有延迟、丢包率、首包时延与带宽吞吐均部署于上海/广州/北京骨干网 Tier-3 物理机房中实测抓取，绝非模拟脚本、绝非商家提供数据。
          </p>
        </div>
      </div>

      <div class="principle-box">
        <div class="p-icon-wrap"><span class="icon-[lucide--scale] p-icon"></span></div>
        <div class="p-content">
          <h4>绝对客观中立原则</h4>
          <p>
            不接受任何机场商家的充值置顶、公关洗地或删帖要求。数据表现差、掉线频繁、暗设高倍率刺客的品牌，一律如实标注并在全网预警。
          </p>
        </div>
      </div>

      <div class="principle-box">
        <div class="p-icon-wrap"><span class="icon-[lucide--file-text] p-icon"></span></div>
        <div class="p-content">
          <h4>推广合规透明披露</h4>
          <p>
            本站部分外链包含 AFF 推广标识（统一标明 <code>rel="nofollow sponsored noopener"</code>）。该佣金仅用于分摊高昂的物理探针机房租金，绝不干扰排名的算法权重。
          </p>
        </div>
      </div>

      <div class="principle-box">
        <div class="p-icon-wrap"><span class="icon-[lucide--alert-octagon] p-icon"></span></div>
        <div class="p-content">
          <h4>法律法规遵从底线</h4>
          <p>
            本实验室致力于分布式网络测量、骨干网路由拓扑与流媒体协议安全研究，不销售、不运营、不转售任何翻墙代理服务。读者请严格遵守当地法律法规。
          </p>
        </div>
      </div>
    </div>

    <!-- 关键数据度量舱 -->
    <div class="lab-metrics-bar">
      <div class="lab-metric-item">
        <span class="m-val">42 家</span>
        <span class="m-lbl">全网审计品牌</span>
        <span class="m-sub">定期全量复测</span>
      </div>
      <div class="lab-metric-item">
        <span class="m-val">3 大节点</span>
        <span class="m-lbl">骨干网物理探针</span>
        <span class="m-sub">沪 / 穗 / 京 IDC</span>
      </div>
      <div class="lab-metric-item">
        <span class="m-val">180+ 天</span>
        <span class="m-lbl">全时段压力追踪</span>
        <span class="m-sub">20:00–23:00 晚高峰</span>
      </div>
      <div class="lab-metric-item">
        <span class="m-val">0 充值</span>
        <span class="m-lbl">纯净算法排序</span>
        <span class="m-sub">代码日志为准</span>
      </div>
    </div>

    <!-- 页面快速锚点导读目录 -->
    <nav class="toc-container" aria-label="关于页目录">
      <div class="toc-title">
        <span class="icon-[lucide--list] toc-icon"></span>
        <strong>关于龙猫云评测实验室 · 深度导读目录</strong>
      </div>
      <div class="toc-grid">
        <a href="#core-mission" class="toc-link">1. 核心定位：打破机场行业的“信息黑盒”</a>
        <a href="#benchmark-vs-market" class="toc-link">2. 评测对比大表：客观测试 vs 普通营销博客</a>
        <a href="#engineering-origin" class="toc-link">3. 创立初衷与工程背景：数据从何而来？</a>
        <a href="#methodology-whitepaper" class="toc-link">4. 物理网络观测方法论（测试标准白皮书）</a>
        <a href="#totoro-score-model" class="toc-link">5. 综合评分体系与梯队评定细则 (Totoro Score)</a>
        <a href="#commercial-ethics" class="toc-link">6. 商业伦理与利益冲突披露防火墙</a>
        <a href="#security-compliance" class="toc-link">7. 读者数据安全、防关联与风控防范指南</a>
        <a href="#action-guidelines" class="toc-link">8. 操作指引：如何最大化利用龙猫云系统？</a>
        <a href="#methodology-faq" class="toc-link">9. 常见疑难与方法论技术 FAQ（10大问答）</a>
        <a href="#topic-cluster-nav" class="toc-link">10. 站内专题集群与延伸阅读导航</a>
      </div>
    </nav>
  </article>

  <!-- 中文深度内容主体：如果非中文则按简要多语言渲染 -->
  {lang === "zh" ? (
    <div class="about-deep-content">
      {/* 模块一：核心定位与快速回答 */}
      <section id="core-mission" class="card content-section">
        <div class="section-badge">CORE MISSION & IDENTITY</div>
        <h2>一、核心定位：为什么我们需要一个客观独立的网络可观测平台？</h2>
        <p class="section-lead">
          在当今跨境互联网生态中，无论是从事跨境电商（亚马逊、TikTok、eBay、Shopify）、跨国 AI 研发（ChatGPT Plus、Claude 3.5 Sonnet、Midjourney API 并发），
          还是科研学者查阅 IEEE/arXiv 论文、外贸企业进行跨国视频会议，稳定高效的跨境网络基础设施已经成为不可或缺的生产力基石。
        </p>
        <p>
          然而，现实中的“机场代理行业”却充斥着高度的信息不对称与道德滑坡：
          <strong>90% 以上的公开推荐渠道本质上是按佣金比例从高到低排列的营销号与水军中介</strong>。
          普通用户缺乏专业的网络工程抓包工具与鉴别能力，极容易遭遇以下痛点：
        </p>

        <div class="pain-points-grid">
          <div class="pain-box">
            <span class="icon-[lucide--zap-off] p-icon-alert"></span>
            <h4>劣质中继冒充物理专线</h4>
            <p>
              商家拿廉价公网 VPS 端口转发包装为“IPLC/IEPL 物理专线”，白天测速看似正常，一到晚高峰（20:00–23:00）骨干网塞车，丢包率瞬间飙升到 30% 以上，卡到无法连通。
            </p>
          </div>
          <div class="pain-box">
            <span class="icon-[lucide--percent] p-icon-alert"></span>
            <h4>隐形扣费与“倍率刺客”</h4>
