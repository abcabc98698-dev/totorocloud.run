---
import { getLanguage, languagePaths, useTranslations } from "../../i18n";
import BlogLayout from "../../layouts/BlogLayout.astro";
import { getProjects } from "../../data/projects";
export const getStaticPaths = languagePaths;
const lang = getLanguage(Astro.params.lang);
const t = useTranslations(lang);
const projects = getProjects(lang);
---

<BlogLayout
  title={t("projects.heading")}
  description={t("meta.projectsDescription")}
  heroTitle={t("projects.heroTitle")}
>
  <section class="card page-card">
    <div class="page-heading">
      <span class="eyebrow">{t("projects.eyebrow")}</span>
      <h2>{t("projects.heading")}</h2>
      <p>{t("projects.description")}</p>
    </div>
    <div class="project-grid">
      {projects.map((project) => (
        <a
          class="project-card"
          href={project.url}
          target="_blank"
          rel="noopener noreferrer"
        >
          <span class="project-icon" aria-hidden="true">
            <span class={project.icon} />
          </span>
          <span
            class="project-arrow icon-[lucide--arrow-up-right]"
            aria-hidden="true"
          />
          <h3>{project.name}</h3>
          <p>{project.description}</p>
          <ul class="project-tech" aria-hidden="true">
            {project.tech.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
          <span class="project-status">{project.status}</span>
        </a>
      ))}
    </div>
  </section>
</BlogLayout>
<style>
  .project-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
  }
  .project-card {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 20px;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: var(--card);
  }
  .project-card:hover {
    border-color: var(--accent);
  }
  .project-icon {
    display: block;
    font-size: 26px;
    color: var(--accent);
    margin-bottom: 12px;
  }
  .project-arrow {
    position: absolute;
    top: 20px;
    right: 18px;
    color: var(--muted);
  }
  .project-card:hover .project-arrow {
    color: var(--accent);
  }
  .project-card h3 {
    font-size: 17px;
    font-weight: 600;
    margin: 0;
  }
  .project-card p {
    color: var(--muted);
    font-size: 15px;
    line-height: 1.55;
    margin: 6px 0 14px;
  }
  .project-tech {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    list-style: none;
    margin: 0 0 14px;
    padding: 0;
  }
  .project-tech li {
    font-size: 12px;
    color: var(--muted);
    border: 1px solid var(--line);
    border-radius: 4px;
    padding: 2px 8px;
  }
  .project-status {
    margin-top: auto;
    font-size: 13px;
    color: var(--accent);
  }
  @media (max-width: 560px) {
    .project-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
